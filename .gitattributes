# Line endings: text files are stored and checked out with LF (as written), except Windows
# scripts, which cmd.exe / PowerShell expect with CRLF. This also silences git's
# "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# binary files
*.npz binary
*.npy binary
*.sqlite binary
*.db binary
*.pt binary
*.png binary
*.ico binary
*.zip binary
